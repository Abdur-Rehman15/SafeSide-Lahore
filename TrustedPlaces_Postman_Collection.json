{
  "info": {
    "name": "SafeSide - Trusted Places API",
    "description": "API collection for managing trusted places",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Trusted Place",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }}",
            "description": "JWT token from login"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Lahore General Hospital\",\n  \"coordinates\": {\n    \"latitude\": 31.5204,\n    \"longitude\": 74.3587\n  },\n  \"phoneNumber\": \"042-99204400\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/trusted-places",
          "host": ["{{baseUrl}}"],
          "path": ["trusted-places"]
        },
        "description": "Create a new trusted place"
      }
    },
    {
      "name": "Get All Trusted Places",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/trusted-places",
          "host": ["{{baseUrl}}"],
          "path": ["trusted-places"]
        },
        "description": "Retrieve all trusted places"
      }
    },
    {
      "name": "Get Trusted Place by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/trusted-places/:id",
          "host": ["{{baseUrl}}"],
          "path": ["trusted-places", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "{{trustedPlaceId}}",
              "description": "Trusted place ID"
            }
          ]
        },
        "description": "Get a single trusted place by ID"
      }
    },
    {
      "name": "Get Nearby Trusted Places",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/trusted-places/nearby?latitude=31.5204&longitude=74.3587&radius=5000",
          "host": ["{{baseUrl}}"],
          "path": ["trusted-places", "nearby"],
          "query": [
            {
              "key": "latitude",
              "value": "31.5204",
              "description": "Your latitude"
            },
            {
              "key": "longitude",
              "value": "74.3587",
              "description": "Your longitude"
            },
            {
              "key": "radius",
              "value": "5000",
              "description": "Radius in meters (default: 5000)"
            }
          ]
        },
        "description": "Get trusted places within a certain radius"
      }
    },
    {
      "name": "Update Trusted Place",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Lahore General Hospital - Updated\",\n  \"phoneNumber\": \"042-99204401\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/trusted-places/:id",
          "host": ["{{baseUrl}}"],
          "path": ["trusted-places", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "{{trustedPlaceId}}"
            }
          ]
        },
        "description": "Update a trusted place"
      }
    },
    {
      "name": "Delete Trusted Place",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/trusted-places/:id",
          "host": ["{{baseUrl}}"],
          "path": ["trusted-places", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "{{trustedPlaceId}}"
            }
          ]
        },
        "description": "Delete a trusted place"
      }
    },
